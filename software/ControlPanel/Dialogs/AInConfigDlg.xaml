<Window x:Class="ControlPanel.Dialogs.AInConfigDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ControlPanel.Dialogs"
        xmlns:sigcore="clr-namespace:SigCoreCommon;assembly=SigCoreCommon"
        Title="Analog Input Configuration"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        FontSize="14">


    <Border CornerRadius="8" BorderBrush="#888" BorderThickness="1" Padding="10" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#805C40" Opacity=".4" BlurRadius="10" ShadowDepth="6"/>
        </Border.Effect>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2"
                       Text="Analog Input Configuration"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="5,0,5,10"/>

            <!-- Name -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" 
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="5,2" Padding="5,2"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="5,2" Padding="5,2"/>

            <!-- Units -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Units:" 
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="5,2" Padding="5,2"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     Text="{Binding Units, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="5,2" Padding="5,2"/>

            <!-- Averaging -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Averaging (1-100):" 
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="5,2" Padding="5,2"/>
            <TextBox x:Name="AveragingSamplesBox" Grid.Row="3" Grid.Column="1"
                     Margin="5,2" Padding="5,2"/>

            <!-- Precision -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Precision (0-9):" 
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="5,2" Padding="5,2"/>
            <TextBox x:Name="PrecisionBox" Grid.Row="4" Grid.Column="1"
                     Margin="5,2" Padding="5,2"/>

            <!-- Display Format -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Display:" 
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="5,2" Padding="5,2"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Range:" 
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="5,2" Padding="5,2"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Cal Type:" 
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="5,2" Padding="5,2"/>
            <ComboBox Grid.Row="5" Grid.Column="1"
                      Margin="5,2" Padding="5,2"
                      ItemsSource="{x:Static local:AInConfigDlgVM.DisplayFormats}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Display, Mode=TwoWay}" />

            <ComboBox Grid.Row="6" Grid.Column="1"
                      Margin="5,2" Padding="5,2"
                      ItemsSource="{x:Static local:AInConfigDlgVM.Ranges}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding InputRange, Mode=TwoWay}" />

            <ComboBox Grid.Row="7" Grid.Column="1"
                      Margin="5,2" Padding="5,2"
                      ItemsSource="{x:Static local:AInConfigDlgVM.CalTypes}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding CalibrationType, Mode=TwoWay}" />

            <!-- mX+b -->
            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Vertical" 
                        x:Name="MxBPanel"
                        >
                <TextBlock x:Name="FormulaText"
           Text="y = m·x + b"
           FontWeight="Bold"
           Margin="5,5,5,0"/>
                <StackPanel Orientation="Horizontal" Margin="5,2">
                    <TextBlock Text="m:" VerticalAlignment="Center" Margin="5,2" Padding="5,2"/>
                    <TextBox Text="{Binding M, Mode=TwoWay}" Width="105" Margin="5,2" Padding="5,2"/>
                    <TextBlock Text="b:" VerticalAlignment="Center" Margin="10,2" Padding="5,2"/>
                    <TextBox Text="{Binding B, Mode=TwoWay}" Width="105" Margin="5,2" Padding="5,2"/>
                </StackPanel>
            </StackPanel>

            <!-- Polynomial: coefficient table -->
            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" x:Name="PolynomialPanel" Margin="5,6,5,0" Width="400">
                <TextBlock Text="Polynomial Calibration" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Enter a coefficient for each polynomial term." Foreground="Gray" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock Text="Term                  Coefficient" FontWeight="SemiBold" Margin="3,0,0,4"/>
                <ScrollViewer Height="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PolynomialRows"/>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                    <Button Content="Add Term" Click="AddTerm_Click" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Remove Highest Term" Click="RemoveTerm_Click" Padding="12,4"/>
                </StackPanel>
                <TextBlock x:Name="PolynomialEquation" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- MultiPoint: input/output calibration table -->
            <StackPanel Grid.Row="10" Grid.ColumnSpan="2" x:Name="MultiPointPanel" Margin="5,6,5,0" Width="400">
                <TextBlock Text="Multi-Point Calibration" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Enter each input and its calibrated output." Foreground="Gray" FontSize="12" Margin="0,0,0,6"/>
                <Grid Margin="3,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Input" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" x:Name="PointOutputHeader" Text="Output" FontWeight="SemiBold"/>
                </Grid>
                <ScrollViewer Height="172" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MultiPointRows"/>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add Point" Click="AddPoint_Click" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Sort by Input" Click="SortPoints_Click" Padding="12,4"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="5,10,5,0">
                <Button Content="OK" Width="105" Margin="5,2" Padding="5,2" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Cancel" Width="105" Margin="5,2" Padding="5,2" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
