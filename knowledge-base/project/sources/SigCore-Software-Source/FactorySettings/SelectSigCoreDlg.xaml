<Window x:Class="FactorySettings.SelectSigCoreDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select SigCore UC"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Discovered SigCore UC devices:"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <ListBox x:Name="DeviceList"
                 Grid.Row="1"
                 SelectionChanged="DeviceList_SelectionChanged"
                 MouseDoubleClick="DeviceList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Address}"
                                   Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Ready, StringFormat=Ready: {0}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Host / IP:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <TextBox x:Name="HostTextBox"
                     Grid.Column="1"
                     Padding="5,3"/>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Connect"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Connect_Click"/>

            <Button Content="Cancel"
                    Width="90"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
